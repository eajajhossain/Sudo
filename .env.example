# Copy to .env, or add the key in SUDO's Settings tab (stored in Windows Credential Manager).
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Optional overrides. Settings saved in the app are used otherwise.
# SUDO_PROVIDER=anthropic
# SUDO_MODEL=claude-opus-5-5
# SUDO_EFFORT=high
# For OpenAI itself, set SUDO_PROVIDER=openai and SUDO_MODEL=gpt-6.1-terra.
# For OpenAI-compatible servers (Groq, OpenRouter, a local model):
# SUDO_PROVIDER=openai
# SUDO_OPENAI_BASE_URL=https://api.groq.com/openai/v1
# SUDO_MODEL=your-model-name
